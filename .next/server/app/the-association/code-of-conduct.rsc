0:["vxQ6WSHm-KZEwi244aErc",[[["",{"children":["the-association",{"children":["code-of-conduct",{"children":["__PAGE__",{}]}]}]},"$undefined","$undefined",true],["",{"children":["the-association",{"children":["code-of-conduct",{"children":["__PAGE__",{},[["$L1",[["$","div",null,{"className":"max-w-[1280px] mx-auto px-4 sm:px-6 py-10 md:py-14","children":["$","div",null,{"className":"md:flex md:gap-16","children":[["$","$L2",null,{}],["$","div",null,{"className":"flex-1 min-w-0 max-w-[680px]","children":[["$","h1",null,{"className":"font-headline text-4xl font-black uppercase mb-8","style":{"color":"#0D1B2A"},"children":[["$","span",null,{"style":{"color":"#E8192C"},"children":"Code"}]," of Conduct"]}],[["$","div","1. Accuracy and Fairness",{"className":"mb-8 pb-8 border-b border-gray-100 last:border-0","children":[["$","h2",null,{"className":"font-bold text-navy text-[16px] mb-3","children":"1. Accuracy and Fairness"}],["$","p",null,{"className":"text-gray-500 text-[14px] leading-relaxed","children":"MJA members commit to reporting facts accurately and presenting information fairly. Journalists must verify information before publication and correct errors promptly and transparently."}]]}],["$","div","2. Independence",{"className":"mb-8 pb-8 border-b border-gray-100 last:border-0","children":[["$","h2",null,{"className":"font-bold text-navy text-[16px] mb-3","children":"2. Independence"}],["$","p",null,{"className":"text-gray-500 text-[14px] leading-relaxed","children":"Members must maintain editorial independence from political, commercial, and personal interests. Journalists should disclose any potential conflicts of interest to their editors and audiences."}]]}],["$","div","3. Humanity",{"className":"mb-8 pb-8 border-b border-gray-100 last:border-0","children":[["$","h2",null,{"className":"font-bold text-navy text-[16px] mb-3","children":"3. Humanity"}],["$","p",null,{"className":"text-gray-500 text-[14px] leading-relaxed","children":"Journalists must treat all individuals with dignity and respect. Special care must be taken when reporting on vulnerable groups, including children, victims of crime, and those experiencing trauma."}]]}],["$","div","4. Accountability",{"className":"mb-8 pb-8 border-b border-gray-100 last:border-0","children":[["$","h2",null,{"className":"font-bold text-navy text-[16px] mb-3","children":"4. Accountability"}],["$","p",null,{"className":"text-gray-500 text-[14px] leading-relaxed","children":"MJA members are accountable to the public they serve. They must be willing to engage in open dialogue about their reporting and accept criticism in a professional manner."}]]}],["$","div","5. Source Protection",{"className":"mb-8 pb-8 border-b border-gray-100 last:border-0","children":[["$","h2",null,{"className":"font-bold text-navy text-[16px] mb-3","children":"5. Source Protection"}],["$","p",null,{"className":"text-gray-500 text-[14px] leading-relaxed","children":"Journalists must protect the confidentiality of sources who provide information under a guarantee of anonymity. This obligation may only be overridden in exceptional circumstances."}]]}],["$","div","6. Respect for Privacy",{"className":"mb-8 pb-8 border-b border-gray-100 last:border-0","children":[["$","h2",null,{"className":"font-bold text-navy text-[16px] mb-3","children":"6. Respect for Privacy"}],["$","p",null,{"className":"text-gray-500 text-[14px] leading-relaxed","children":"The right to privacy must be respected. Private individuals have stronger privacy rights than public figures. Intrusion into private life is only justified when there is genuine public interest."}]]}],["$","div","7. Professional Integrity",{"className":"mb-8 pb-8 border-b border-gray-100 last:border-0","children":[["$","h2",null,{"className":"font-bold text-navy text-[16px] mb-3","children":"7. Professional Integrity"}],["$","p",null,{"className":"text-gray-500 text-[14px] leading-relaxed","children":"Members must not accept bribes, gifts, or any form of payment that could influence their reporting. Journalists must not misrepresent their identity or engage in deception to obtain information except in exceptional circumstances."}]]}],["$","div","8. Safety",{"className":"mb-8 pb-8 border-b border-gray-100 last:border-0","children":[["$","h2",null,{"className":"font-bold text-navy text-[16px] mb-3","children":"8. Safety"}],["$","p",null,{"className":"text-gray-500 text-[14px] leading-relaxed","children":"MJA is committed to the safety of all journalists. Members should not take unnecessary risks and should report threats or harassment to the association immediately."}]]}]]]}]]}]}],["$","section",null,{"className":"py-14 px-6 border-t border-gray-100","children":["$","div",null,{"className":"max-w-[1280px] mx-auto","children":[["$","h2",null,{"className":"font-headline text-4xl font-bold mb-6","style":{"color":"#0D1B2A"},"children":["Don't wait for information being deprived",["$","br",null,{}],"of you to ",["$","span",null,{"style":{"color":"#E8192C"},"children":"defend it!"}]]}],["$","$L3",null,{}]]}]}]]],null],null]},["$","$L4",null,{"parallelRouterKey":"children","segmentPath":["children","the-association","children","code-of-conduct","children"],"error":"$undefined","errorStyles":"$undefined","errorScripts":"$undefined","template":["$","$L5",null,{}],"templateStyles":"$undefined","templateScripts":"$undefined","notFound":"$undefined","notFoundStyles":"$undefined","styles":null}],null]},["$","$L4",null,{"parallelRouterKey":"children","segmentPath":["children","the-association","children"],"error":"$undefined","errorStyles":"$undefined","errorScripts":"$undefined","template":["$","$L5",null,{}],"templateStyles":"$undefined","templateScripts":"$undefined","notFound":"$undefined","notFoundStyles":"$undefined","styles":null}],null]},[["$","html",null,{"lang":"en","children":[["$","head",null,{"children":[["$","link",null,{"rel":"preconnect","href":"https://fonts.googleapis.com"}],["$","link",null,{"rel":"preconnect","href":"https://f